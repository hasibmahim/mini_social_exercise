{% extends "base.html.j2" %}
{# Coding Assignment #3, newcomer journey (Chapter 5, Design Claim 22): the cohort page.
   Everyone who joined in the same month, and how far each person is. #}
{% block content %}
<div class="row justify-content-center">
  <div class="col-lg-8">
    <h2 class="mb-1">Newcomers who joined in {{ cohort }}</h2>
    <p class="text-muted">You go through the same three steps together. Step 3 is to welcome one of them.</p>

    <div class="card">
      <ul class="list-group list-group-flush">
        {% for person in people %}
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <div>
            <a href="{{ url_for('user_profile', username=person.username) }}">@{{ person.username }}</a>
            {% if person.done == 3 %}<span class="badge bg-success ms-1">Settled in</span>{% endif %}
            <div class="small text-muted">
              Steps done: {{ person.done }}/3
              {% for i in range(3) %}{% if i < person.done %}&#9679;{% else %}&#9675;{% endif %}{% endfor %}
            </div>
          </div>
          {% if person.intro_post and person.id != session.get('user_id') %}
            <a href="{{ url_for('post_detail', post_id=person.intro_post) }}" class="btn btn-success btn-sm">Read and welcome</a>
          {% elif person.id == session.get('user_id') %}
            <span class="small text-muted">This is you</span>
          {% else %}
            <span class="small text-muted">No introduction yet</span>
          {% endif %}
        </li>
        {% else %}
        <li class="list-group-item">Nobody joined this month yet.</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>
{% endblock %}
